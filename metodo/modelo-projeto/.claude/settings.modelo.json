{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "METODO_MIGRATIONS_DIRS": "supabase/migrations:migrations",
    "METODO_BRANCH_BASE": "main"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/barrar-comandos.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/barrar-migration-existente.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
